# Copy to .env and fill in. Never commit .env.
# Muse SDK token from https://gadgets.muse.ai/settings/sdk-tokens (gated by Meta; personal, non-commercial use only).
MUSE_SDK_TOKEN=
# Shared secret for the LAN bridge. Generate one: openssl rand -hex 24
BRIDGE_SECRET=
# Where command sources (Pi gadget, mock CLI, ESP32) reach the bridge on the Windows PC.
BRIDGE_URL=ws://192.168.1.50:8791/ws
# Port the bridge listens on (also serves /display at http://localhost:PORT/).
BRIDGE_PORT=8791
